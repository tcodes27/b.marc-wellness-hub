# ============================================================
#  B.MARC PILATES — ENVIRONMENT VARIABLES (example)
# ============================================================
#  Copy this file to `.env` and fill in real values.
#  These are SERVER-ONLY secrets — never prefix with VITE_.
# ============================================================

# --- Instagram Graph API ----------------------------------------------------
# Numeric Instagram Business Account ID for @bmarcpilates.
INSTAGRAM_USER_ID=17841444163593570

# Long-lived Instagram Graph API access token (60-day, refreshable).
# Replace `add_token_here` once the token is generated in the Meta dashboard.
# Required scopes: instagram_basic, pages_show_list, pages_read_engagement
INSTAGRAM_ACCESS_TOKEN=add_token_here
